DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
API_KEY=dev-api-key
API_HOST=0.0.0.0
API_PORT=8000
WEBHOOK_TIMEOUT=10
MAX_RETRIES=3
RETRY_BASE_DELAY=2
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1
WORKER_HEARTBEAT_FILE=/tmp/async-payments-worker.heartbeat
WORKER_HEARTBEAT_INTERVAL=5
